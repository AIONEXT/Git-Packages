{
  "name": "kafkajs-next",
  "version": "0.1.0",
  "description": "TypeScript-first Kafka client with schema validation, TypeScript consumer groups, and zero-config monitoring — co-maintained fork of kafkajs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test && npm run lint"
  },
  "keywords": [
    "kafka",
    "kafkajs",
    "typescript",
    "consumer",
    "producer",
    "schema-registry",
    "avro",
    "protobuf"
  ],
  "author": "AIONEXT <aionext@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AIONEXT/kafkajs-next.git"
  },
  "bugs": {
    "url": "https://github.com/AIONEXT/kafkajs-next/issues"
  },
  "homepage": "https://github.com/AIONEXT/kafkajs-next#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "zod": "^4.6.7",
    "@kafkajs/consumer-group": "^1.0.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^1.2.0",
    "testcontainers": "^10.9.0",
    "@types/jest": "^29.5.11"
  },
  "packageManager": "npm@10.2.4"
}